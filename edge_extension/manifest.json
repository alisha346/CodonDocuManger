{
  "manifest_version": 3,
  "name": "CodonDocuManger Companion",
  "version": "1.04.01",
  "description": "Microsoft Edge companion to control CodonDocuManger guide recorder directly from the toolbar.",
  "key": "",
  "action": {
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8765/*",
        "http://127.0.0.1:8765/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "http://localhost:8765/*",
    "http://127.0.0.1:8765/*"
  ]
}